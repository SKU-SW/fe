{
  "name": "swproject",
  "version": "0.1.9",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "electron:build-main": "tsc --project tsconfig.electron.json",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:build-main && cross-env NODE_ENV=development electron dist-electron/main.js\"",
    "electron:build": "npm run electron:build-main && npm run build && electron-builder",
    "electron:preview": "npm run electron:build-main && npm run build && cross-env NODE_ENV=production electron dist-electron/main.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@pixiv/three-vrm": "^3.5.3",
    "@tailwindcss/forms": "^0.5.11",
    "axios": "^1.15.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "react-router-dom": "^7.14.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.9",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.swproject.app",
    "productName": "Live Buddy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.cjs",
    "extraResources": [
      {
        "from": "dist-stt/stt_server",
        "to": "stt"
      },
      {
        "from": "dist-stt/models",
        "to": "models"
      }
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "SKU-SW",
      "repo": "fe"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "LiveBuddy-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "음성 인식(STT)을 위해 마이크에 접근합니다."
      }
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "artifactName": "LiveBuddy-win-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
