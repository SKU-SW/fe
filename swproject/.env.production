# 프로덕션 빌드(electron-builder) 전용 환경변수.
# vite build 시 .env.local 보다 우선 적용된다 (Vite mode 파일 우선순위).
# 공개 dev 클라우드 도메인이라 시크릿 아님 → CI 빌드를 위해 git 으로 커밋한다.

# Spring Boot Backend (Remote)
VITE_API_BASE_URL=https://dev.sku-sw.cloud

# WebSocket
VITE_WS_URL=wss://dev.sku-sw.cloud

# Character Assets (Images & Voice Samples)
VITE_IMAGE_BASE_URL=https://dev-img.sku-sw.cloud
